# Copy to .env and fill with your API credentials

# GLM/Zhipu AI API Key
ZHIPU_API_KEY=your_zhipu_api_key_here

# Staged reviewed-reading additions; enable only after deploying API and validators.
ASTROFRIEND_EXTENDED_PERIOD_RULES=0
VEDASTRO_NATIVE_FINANCE_ENABLED=0

# Twilio credentials for WhatsApp (optional)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+17343367101
